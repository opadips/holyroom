# ─────────────────────────────────────────────────────────────
#  Holyroom — Client environment (optional)
#
#  You do NOT need this file for LAN use.
#  The client automatically fetches the server's IP at runtime.
#
#  Only set REACT_APP_SERVER_URL if you want to override the
#  auto-detection — e.g. for a production/cloud deployment.
#
#  Example:
#  REACT_APP_SERVER_URL=https://holyroom.example.com
# ─────────────────────────────────────────────────────────────
REACT_APP_SERVER_URL=
